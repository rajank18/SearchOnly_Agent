# ==============================================================================
# Environment Configuration
# All keys have free tiers ($0 cost to run).
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider Configuration (OpenRouter Free Tier)
# ------------------------------------------------------------------------------
# OpenRouter API Key (Free models require an account at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models: Free tier models available on OpenRouter (defaults may rotate; override as needed)
FAST_MODEL=nvidia/nemotron-3.5-super-vl:free
STRONG_MODEL=nvidia/nemotron-3.5-super-vl:free
FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free

# ------------------------------------------------------------------------------
# Search Provider Configuration (Set at least one; comma-separated order = priority)
# ------------------------------------------------------------------------------
SEARCH_PROVIDERS=tavily,exa

# Tavily Search API (Free tier: 1,000 searches/month, no card required)
# Sign up at: https://app.tavily.com/
TAVILY_API_KEY=

# Exa Search API (Free tier: $10 free credit on signup)
# Sign up at: https://dashboard.exa.ai/
EXA_API_KEY=

# ------------------------------------------------------------------------------
# Runtime Limits & Defaults
# ------------------------------------------------------------------------------
MAX_SEARCHES_PER_TURN=6
MAX_PARALLEL_SEARCHES=5
SEARCH_TIMEOUT_MS=8000
DEFAULT_TIMEZONE=Asia/Kolkata
DB_PATH=./data/agent.db
PORT=3000
