{
  "name": "thedude",
  "version": "0.1.0",
  "description": "Scaffold for search-only chat agent hiring challenge",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
